# ============================================
# CABIDÊ — Variáveis de ambiente (exemplo, sem valores reais)
# Copie para .env.local (local) e configure na Vercel.
# NUNCA coloque segredos em variáveis NEXT_PUBLIC_*: elas vão para o navegador.
# ============================================

# --- PUBLIC (vão para o navegador; protegidas por RLS no Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# --- SERVER ONLY (nunca prefixar com NEXT_PUBLIC_) ---
ANTHROPIC_API_KEY=your_key_here

# Beta: false = somente com convite (padrão) | true = cadastro livre
CABIDE_PUBLIC_BETA=false

# Opcional: sobrescrever modelos de IA sem alterar código
# CABIDE_MODEL_CATALOG=claude-haiku-4-5-20251001
# CABIDE_MODEL_LOOKS=claude-sonnet-4-20250514
# CABIDE_MODEL_INTERVIEW=claude-sonnet-4-20250514

# NÃO é necessária no app. Se algum dia for usada, apenas no servidor:
# SUPABASE_SERVICE_ROLE_KEY=
